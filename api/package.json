{
  "name": "adote",
  "version": "1.0.0",
  "description": "",
  "author": "igor morais",
  "private": true,
  "scripts": {
    "type:check": "tsc -b",
    "lint": "eslint \"{src,spec}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,spec}/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"spec/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"spec/**/*.ts\"",
    "load": "bun ./src/load.ts",
    "start": "bun --watch ./src/main.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage"
  },
